[Unit]
Description=corne-usb-bridge (nivel de sistema; activo desde el arranque, tambien en el login)
# arrancar ANTES que la pantalla de login para agarrar las mitades primero
Before=display-manager.service graphical.target

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe uinput
# install.sh reescribe la ruta del --vil con tu keymap. -u = logs sin buffer.
ExecStart=/usr/bin/python3 -u /opt/corne-usb-bridge/linux/corne_bridge_linux.py --vil /opt/corne-usb-bridge/keymaps/user.vil
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
